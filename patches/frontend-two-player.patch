+void players::assign_device(int index, SDL_GameController* controller, bool keyboard) {
+    if (index < 0 || index >= 2) return;
+    auto& player = PlayerState.players[index];
+    player.controller = controller;
+    player.keyboard_enabled = keyboard;
+    PlayerState.players.set_count(2);
+    int profile=controller ? profiles::get_controller_profile_index_from_sdl_controller(controller) : -1;
+    if(controller && (index==0 || profile<0)) profile=profiles::get_sp_controller_profile_index();
+    if(index==1 && profile>=0) {
+        std::string key="wetrix_player2_"+profiles::get_input_profile_key(profile);
+        int separate=profiles::get_input_profile_by_key(key);
+        if(separate<0) {
+            separate=profiles::add_input_profile(key,"Player 2 Controller",InputDevice::Controller,true);
+            for(int input=0;input<int(GameInput::COUNT);++input)
+                for(size_t binding=0;binding<num_bindings_per_input;++binding)
+                    profiles::set_input_binding(separate,GameInput(input),binding,profiles::get_input_binding(profile,GameInput(input),binding));
+        }
+        profile=separate;
+    }
+    profiles::set_input_profile_for_player(index, profile, InputDevice::Controller);
+    profiles::set_input_profile_for_player(index, keyboard ? (index == 0 ? profiles::get_sp_keyboard_profile_index() : profiles::get_or_create_mp_keyboard_profile_index(index)) : -1, InputDevice::Keyboard);
+}

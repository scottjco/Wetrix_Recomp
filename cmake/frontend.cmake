execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_SOURCE_DIR}/tools/patch_frontend.py" COMMAND_ERROR_IS_FATAL ANY)
set(RECOMP_FRONTEND_N64MODERNRUNTIME_PATH "${CMAKE_SOURCE_DIR}/lib/N64ModernRuntime")
set(RECOMP_FRONTEND_RT64_PATH "${CMAKE_SOURCE_DIR}/lib/rt64")
set(sdl2_SOURCE_DIR "${RECOMP_FRONTEND_RT64_PATH}/src/contrib/mupen64plus-win32-deps/SDL2-2.26.3")
if(WIN32)
  set(DXC "${RECOMP_FRONTEND_RT64_PATH}/src/contrib/dxc/bin/x64/dxc.exe")
elseif(APPLE)
  if(CMAKE_SYSTEM_PROCESSOR MATCHES "arm64|aarch64")
    set(WETRIX_SHADER_ARCH arm64)
  else()
    set(WETRIX_SHADER_ARCH x64)
  endif()
  set(DXC "${CMAKE_COMMAND}" -E env "DYLD_LIBRARY_PATH=${RECOMP_FRONTEND_RT64_PATH}/src/contrib/dxc/lib/${WETRIX_SHADER_ARCH}" "${RECOMP_FRONTEND_RT64_PATH}/src/contrib/dxc/bin/${WETRIX_SHADER_ARCH}/dxc-macos")
  set(SPIRVCROSS "${CMAKE_COMMAND}" -E env "DYLD_LIBRARY_PATH=${RECOMP_FRONTEND_RT64_PATH}/src/contrib/spirv-cross/lib/${WETRIX_SHADER_ARCH}" "${RECOMP_FRONTEND_RT64_PATH}/src/contrib/spirv-cross/bin/${WETRIX_SHADER_ARCH}/spirv-cross")
else()
  if(CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64")
    set(WETRIX_SHADER_ARCH arm64)
  else()
    set(WETRIX_SHADER_ARCH x64)
  endif()
  set(DXC "${CMAKE_COMMAND}" -E env "LD_LIBRARY_PATH=${RECOMP_FRONTEND_RT64_PATH}/src/contrib/dxc/lib/${WETRIX_SHADER_ARCH}" "${RECOMP_FRONTEND_RT64_PATH}/src/contrib/dxc/bin/${WETRIX_SHADER_ARCH}/dxc-linux")
endif()
set(DXC_DXIL_OPTS "-Wno-ignored-attributes")
set(DXC_SPV_OPTS "-spirv" "-fspv-target-env=vulkan1.0" "-fvk-use-dx-layout")
set(DXC_VS_OPTS "-E" "VSMain" "-T" "vs_6_0" "-fvk-invert-y")
set(DXC_PS_OPTS "-E" "PSMain" "-T" "ps_6_0")
add_subdirectory(lib/N64ModernRuntime/thirdparty/miniz EXCLUDE_FROM_ALL)
add_subdirectory(lib/RecompFrontend EXCLUDE_FROM_ALL)
foreach(frontend_target recompui recompinput)
  set_property(TARGET ${frontend_target} PROPERTY COMPILE_OPTIONS "")
  target_compile_definitions(${frontend_target} PRIVATE NOMINMAX _CRT_SECURE_NO_WARNINGS WETRIX_RECOMP)
  if(MSVC)
    target_compile_options(${frontend_target} PRIVATE /Gy /EHsc /MP)
  endif()
  target_include_directories(${frontend_target} PRIVATE "${CMAKE_SOURCE_DIR}/lib/N64Recomp/include")
endforeach()
# Wetrix already owns its renderer and runtime; use the common menu renderer.
get_target_property(ui_sources recompui SOURCES)
list(FILTER ui_sources EXCLUDE REGEX "/(rt64_render_context|ui_state).cpp$")
list(FILTER ui_sources EXCLUDE REGEX "/api/")
list(FILTER ui_sources EXCLUDE REGEX "/util/file.cpp$")
set_property(TARGET recompui PROPERTY SOURCES "${ui_sources}")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_SOURCE_DIR}/tools/prepare_frontend.py" COMMAND_ERROR_IS_FATAL ANY)
target_sources(recompui PRIVATE "${CMAKE_SOURCE_DIR}/build/generated-runtime/ui_state.cpp" "${CMAKE_SOURCE_DIR}/build/generated-runtime/ui_file.cpp")
target_include_directories(recompui PRIVATE "${CMAKE_SOURCE_DIR}/src")
target_sources(WetrixRuntime PRIVATE src/menu.cpp src/wetrix_devices.cpp
  lib/N64ModernRuntime/librecomp/src/files.cpp
  lib/N64ModernRuntime/librecomp/src/config.cpp
  lib/N64ModernRuntime/librecomp/src/config_option.cpp)
target_link_libraries(WetrixRuntime PRIVATE recompui recompinput nfd)
if(MSVC)
  target_compile_options(WetrixRuntime PRIVATE /Gy)
  target_link_options(WetrixRuntime PRIVATE /OPT:REF)
endif()
add_custom_command(TARGET WetrixRuntime POST_BUILD
  COMMAND ${CMAKE_COMMAND} -E copy_directory "${CMAKE_SOURCE_DIR}/Assets/menu" "$<TARGET_FILE_DIR:WetrixRuntime>/assets")
